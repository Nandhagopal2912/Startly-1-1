# Copy to backend/.env and fill in. Never commit backend/.env.

# Where SERP data comes from: serpapi | serper | dataforseo | mock
# serpapi detects AI Overviews (the 45% zero-click penalty); serper does not.
SERP_PROVIDER=serper

# SerpApi (free tier: 250 searches/month): https://serpapi.com
SERPAPI_API_KEY=

# Serper.dev (free tier available, no AI Overview data): https://serper.dev
SERPER_API_KEY=

# Where search volume comes from: dataforseo | none
# With "none", enter volume in the UI's Volume box (e.g. from Google Keyword Planner).
VOLUME_PROVIDER=none

# DataForSEO (paid). Only needed if SERP_PROVIDER or VOLUME_PROVIDER is dataforseo.
DATAFORSEO_EMAIL=
DATAFORSEO_PASSWORD=

# Safety: max outbound paid API calls per day (0 blocks all live calls).
MAX_API_CALLS_PER_DAY=50

# Days before a cached keyword is fetched again (0 = never expire).
CACHE_TTL_DAYS=7

# --- Public deployment ---
# Read-only demo: serves saved analyses only, never calls a provider or writes to the database.
DEMO_MODE=false

# Browser origins allowed to call the API (comma-separated). Set to your frontend's URL when hosting.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Requests per client IP per minute (0 = no limit).
RATE_LIMIT_PER_MINUTE=120

# Behind a hosting proxy (Render, Fly.io, Railway...), read the client IP from X-Forwarded-For.
TRUST_PROXY_HEADERS=false
